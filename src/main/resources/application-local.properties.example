# Copy this file to application-local.properties (gitignored) and adjust if needed.
# Default values match docker-compose.yml — no changes needed if using Docker.

spring.datasource.url=jdbc:postgresql://localhost:5432/electronest
spring.datasource.username=electronest
spring.datasource.password=electronest_dev

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
